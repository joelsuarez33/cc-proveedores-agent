# =====================================================================
# 1) CARGA DE DATOS — solo en tu máquina, se usa al correr load_to_supabase.py
#    Dashboard > Connect > ORMs/Session pooler. Contiene la password de Postgres.
# =====================================================================
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# =====================================================================
# 2) RUNTIME DEL AGENTE — Dashboard > Settings > API Keys
#    Publishable (sb_publishable_...) = rol `anon`. Con RLS activo y sin
#    policies, solo puede ejecutar el RPC. NO uses la secret key acá.
# =====================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# =====================================================================
# 3) CEREBRO — console.anthropic.com > API Keys
# =====================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
